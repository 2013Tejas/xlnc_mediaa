<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1080 1920" width="100%" height="100%">
  <defs>
    <!-- Background & Bubble drop shadows -->
    <filter id="bubbleDrop2" x="-5%" y="-5%" width="110%" height="115%">
      <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- Phone Background Deep WhatsApp Dark Mode -->
  <rect width="1080" height="1920" fill="#0c1317" />

  <!-- WhatsApp Doodle Wallpaper (Authentic vector motifs) -->
  <g opacity="0.035" stroke="#ffffff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- Chat bubble doodle -->
    <path d="M 120 320 C 120 300, 160 300, 160 320 C 160 335, 145 345, 140 355 L 135 365 L 132 355 C 125 345, 120 335, 120 320 Z" />
    <!-- Coffee cup -->
    <path d="M 450 360 L 490 360 L 485 395 C 485 405, 455 405, 455 395 Z" />
    <path d="M 490 365 C 500 365, 500 385, 488 385" />
    <!-- Music note -->
    <path d="M 850 420 L 850 390 L 890 380 L 890 410" />
    <circle cx="840" cy="425" r="10" fill="#ffffff" />
    <circle cx="880" cy="415" r="10" fill="#ffffff" />
    <!-- Heart doodle -->
    <path d="M 280 620 C 270 605, 250 610, 250 630 C 250 650, 280 670, 280 670 C 280 670, 310 650, 310 630 C 310 610, 290 605, 280 620 Z" />
    <!-- Clock -->
    <circle cx="720" cy="680" r="24" />
    <path d="M 720 668 L 720 680 L 732 686" />
    <!-- Camera -->
    <rect x="920" y="820" width="40" height="30" rx="6" />
    <circle cx="940" cy="835" r="8" />
    <path d="M 932 820 L 936 814 L 944 814 L 948 820" />
    <!-- Star -->
    <path d="M 160 980 L 164 992 L 176 992 L 166 1000 L 170 1012 L 160 1004 L 150 1012 L 154 1000 L 144 992 L 156 992 Z" />
    <!-- Paper plane -->
    <path d="M 480 1140 L 530 1120 L 500 1170 L 495 1150 Z" />
    <!-- Headphones -->
    <path d="M 780 1260 C 780 1230, 830 1230, 830 1260 L 830 1285" />
    <rect x="774" y="1265" width="12" height="22" rx="4" fill="#ffffff" />
    <rect x="824" y="1265" width="12" height="22" rx="4" fill="#ffffff" />
    <!-- Smiley -->
    <circle cx="260" cy="1420" r="26" />
    <circle cx="252" cy="1414" r="3" fill="#ffffff" />
    <circle cx="268" cy="1414" r="3" fill="#ffffff" />
    <path d="M 250 1428 C 255 1438, 265 1438, 270 1428" />
  </g>

  <!-- iOS Status Bar (Top) -->
  <g fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif">
    <!-- Time: 12:33 -->
    <text x="142" y="80" font-size="34" font-weight="600" text-anchor="middle" letter-spacing="-0.5">12:33</text>

    <!-- iPhone Dynamic Island -->
    <rect x="420" y="38" width="240" height="58" rx="29" fill="#000000" />
    <circle cx="616" cy="67" r="12" fill="#121212" />
    <circle cx="616" cy="67" r="5" fill="#0a192f" opacity="0.6" />

    <!-- Right Side Status Icons -->
    <g transform="translate(840, 52)">
      <!-- 4 Cellular Signal Bars -->
      <rect x="0" y="20" width="6.5" height="10" rx="2" fill="#ffffff" />
      <rect x="11" y="15" width="6.5" height="15" rx="2" fill="#ffffff" />
      <rect x="22" y="9" width="6.5" height="21" rx="2" fill="#ffffff" />
      <rect x="33" y="3" width="6.5" height="27" rx="2" fill="#ffffff" />

      <!-- 5G Label -->
      <text x="56" y="27" font-size="24" font-weight="700">5G</text>

      <!-- Battery with 30% indicator -->
      <g transform="translate(104, 2)">
        <rect x="0" y="2" width="54" height="26" rx="7" fill="none" stroke="#ffffff" stroke-width="2.5" opacity="0.4" />
        <rect x="3" y="5" width="22" height="20" rx="4" fill="#facc15" />
        <path d="M 56 10 L 56 20" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.4" />
        <text x="27" y="22" font-size="16" font-weight="700" fill="#000000" text-anchor="middle">30</text>
      </g>
    </g>
  </g>

  <!-- WhatsApp Top Navigation Header Bar -->
  <rect x="0" y="120" width="1080" height="126" fill="#111b21" />
  <line x1="0" y1="246" x2="1080" y2="246" stroke="#1f2c34" stroke-width="1.5" />

  <g font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif">
    <!-- Back Button: < 514 in iOS WhatsApp Blue -->
    <g transform="translate(36, 160)">
      <path d="M 26 36 L 6 18 L 26 0" stroke="#53bdeb" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <text x="36" y="27" font-size="34" font-weight="400" fill="#53bdeb" letter-spacing="-0.5">514</text>
    </g>

    <!-- Group Avatar -->
    <g transform="translate(160, 140)">
      <circle cx="43" cy="43" r="43" fill="#6c3b2b" />
      <circle cx="36" cy="38" r="14" fill="#dfd0be" />
      <path d="M 18 69 C 18 56, 25 50, 36 50 C 47 50, 54 56, 54 69 Z" fill="#dfd0be" />
      <circle cx="56" cy="34" r="11" fill="#dfd0be" opacity="0.8" />
      <path d="M 43 66 C 43 56, 50 50, 59 50 C 67 50, 73 56, 73 66 Z" fill="#dfd0be" opacity="0.8" />
    </g>

    <!-- Group Title and Members -->
    <text x="270" y="174" font-size="32" font-weight="600" fill="#e9edef" letter-spacing="-0.3">XLNC x Sportygen!</text>
    <text x="270" y="210" font-size="22" font-weight="400" fill="#8696a0">Lokesh BSN, Mayur Sir Sportyg...</text>

    <!-- Header Actions (Video Call Pill Button) -->
    <g transform="translate(930, 150)">
      <rect x="0" y="0" width="102" height="66" rx="33" fill="#005c4b" fill-opacity="0.3" stroke="#00a884" stroke-width="2" />
      <path d="M 30 24 L 52 24 C 55 24, 58 27, 58 30 L 58 42 C 58 45, 55 48, 52 48 L 30 48 C 27 48, 24 45, 24 42 L 24 30 C 24 27, 27 24, 30 24 Z" fill="#25d366" />
      <path d="M 58 32 L 74 24 L 74 48 L 58 40 Z" fill="#25d366" />
      <path d="M 82 33 L 87 38 L 92 33" stroke="#25d366" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </g>
  </g>

  <!-- CHAT CONVERSATION -->

  <!-- Message 1: Incoming from Mayur Sir Sportygen Arena -->
  <g transform="translate(100, 290)" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif">
    <!-- Bubble Background (#202c33) -->
    <rect x="0" y="0" width="790" height="420" rx="28" fill="#202c33" filter="url(#bubbleDrop2)" />

    <!-- Sender Name: Mayur Sir Sportygen Arena (Cyan/Sky Blue) -->
    <text x="36" y="58" font-size="34" font-weight="600" fill="#53bdeb" letter-spacing="-0.3">Mayur Sir Sportygen Arena</text>

    <!-- Message Body Lines -->
    <text x="36" y="120" font-size="36" font-weight="400" fill="#e9edef">
      <tspan x="36" dy="0">Hi Lokesh</tspan>
      <tspan x="36" dy="68">Really appreciate all the effort</tspan>
      <tspan x="36" dy="64">Results look very promising n</tspan>
      <tspan x="36" dy="58">great to see improvement in the</tspan>
      <tspan x="36" dy="58">campaign</tspan>
    </text>

    <!-- Timestamp: 12:12 PM -->
    <text x="760" y="390" font-size="24" font-weight="400" fill="#8696a0" text-anchor="end">12:12 PM</text>
  </g>

  <!-- Message 2: Continuation from Mayur Sir (with Avatar on bottom-left) -->
  <g transform="translate(100, 740)" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif">
    <!-- Bubble Background (#202c33) with tail at bottom-left -->
    <path d="M 28 0 L 790 0 C 806 0, 818 12, 818 28 L 818 220 C 818 236, 806 248, 790 248 L 28 248 C 12 248, 0 236, 0 220 L 0 244 C 0 248, -6 252, -12 252 C -6 244, 0 232, 0 220 L 0 28 C 0 12, 12 0, 28 0 Z" fill="#202c33" filter="url(#bubbleDrop2)" />

    <!-- Message Body Text -->
    <text x="36" y="64" font-size="35" font-weight="400" fill="#e9edef">
      <tspan x="36" dy="0">Will discuss the next steps</tspan>
      <tspan x="36" dy="58">internally with Pramod Sir and</tspan>
      <tspan x="36" dy="58">get back to you soon</tspan>
    </text>

    <!-- Timestamp: 12:13 PM -->
    <text x="784" y="218" font-size="24" font-weight="400" fill="#8696a0" text-anchor="end">12:13 PM</text>
  </g>

  <!-- Avatar for Mayur Sir (Bottom-left of message 2) -->
  <g transform="translate(60, 960)">
    <circle cx="0" cy="0" r="38" fill="#0284c7" stroke="#0c1317" stroke-width="4" />
    <text x="0" y="13" font-size="38" font-weight="700" fill="#ffffff" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif">M</text>
  </g>

  <!-- Message 3: Outgoing Reply from Lokesh with Quoted Text (Green Bubble #005c4b) -->
  <g transform="translate(390, 1030)" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif">
    <!-- Bubble Background with tail at bottom-right -->
    <path d="M 28 0 L 630 0 C 646 0, 658 12, 658 28 L 658 280 C 658 290, 666 302, 672 310 C 666 310, 658 306, 658 302 L 658 310 C 658 326, 646 338, 630 338 L 28 338 C 12 338, 0 326, 0 310 L 0 28 C 0 12, 12 0, 28 0 Z" fill="#005c4b" filter="url(#bubbleDrop2)" />

    <!-- Quoted Box Inside Reply -->
    <g transform="translate(18, 18)">
      <rect x="0" y="0" width="622" height="150" rx="14" fill="#025144" />
      <!-- Cyan left accent bar -->
      <rect x="0" y="0" width="8" height="150" rx="4" fill="#53bdeb" />

      <!-- Quoted Sender Name -->
      <text x="24" y="38" font-size="27" font-weight="600" fill="#53bdeb">Mayur Sir Sportygen Arena</text>
      <!-- Quoted snippet text -->
      <text x="24" y="76" font-size="25" font-weight="400" fill="#e9edef" opacity="0.85">Hi Lokesh</text>
      <text x="24" y="118" font-size="25" font-weight="400" fill="#e9edef" opacity="0.85">Really appreciate all the effort</text>
    </g>

    <!-- Reply Text Below Quote -->
    <text x="28" y="240" font-size="38" font-weight="400" fill="#e9edef">Thank You! ✨</text>

    <!-- Timestamp & Double Blue Ticks -->
    <g transform="translate(626, 316)">
      <text x="-36" y="-2" font-size="24" font-weight="400" fill="#8696a0" text-anchor="end">1:02 PM</text>
      <!-- Blue Read Receipts -->
      <path d="M -26 -6 L -19 1 L -8 -11" stroke="#53bdeb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M -18 -6 L -11 1 L 0 -11" stroke="#53bdeb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </g>
  </g>

</svg>
